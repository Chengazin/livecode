APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=livecode
REVERB_APP_KEY=livecode-key
REVERB_APP_SECRET=livecode-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8081
REVERB_BROADCAST_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_SERVER_PATH=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Forgejo OAuth
# Internal Forgejo URL used by backend for API requests (and default for git push).
FORGEJO_BASE_URL=
# Public Forgejo URL used for browser redirects in OAuth flow.
# Example when backend is in Docker: FORGEJO_BASE_URL=http://forgejo:3000 and FORGEJO_PUBLIC_URL=http://localhost:3000
FORGEJO_PUBLIC_URL=
# Optional git remote base URL for push (defaults to FORGEJO_BASE_URL).
FORGEJO_GIT_BASE_URL=
FORGEJO_CLIENT_ID=
FORGEJO_CLIENT_SECRET=
# Must point to frontend callback route, not /api/forgejo/oauth/callback
FORGEJO_REDIRECT_URL=http://localhost:8080/forgejo/callback
FORGEJO_OAUTH_SCOPES=read:user,write:user,read:repository,write:repository
FORGEJO_AUTO_LINK_BY_EMAIL=false

# Optional absolute path to git binary used by backend git commands.
# Example on Windows: C:\\Program Files\\Git\\cmd\\git.exe
# GIT_BINARY=

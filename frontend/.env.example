VUE_APP_BACKEND_URL=http://127.0.0.1:8000
# Optional: direct API base (if proxy is not used)
# VUE_APP_API_BASE_URL=http://127.0.0.1:8000/api
VUE_APP_REVERB_APP_KEY=livecode-key
# Leave empty to use current browser host (recommended for LAN dev):
# VUE_APP_REVERB_HOST=
VUE_APP_REVERB_PORT=8081
VUE_APP_REVERB_SCHEME=http
# Optional custom auth endpoint:
# VUE_APP_REVERB_AUTH_ENDPOINT=/api/broadcasting/auth
